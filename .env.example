# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/telegram_scheduler

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-32-byte-fernet-encryption-key-base64-encoded=

# ─── Telegram MTProto API ─────────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Worker Settings ──────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=60
METRICS_INTERVAL_SECONDS=1800
